  "narrative": {
    "northStar": "The Classic Wallpaper Workbench",
    "overview": "AetherWall is a native Windows 11 desktop utility in Operate mode. The user-approved direction closely follows the classic Wallpaper Engine experience: compact controls, graphite surfaces, blue selection, and original scene imagery as the visual focus. Segoe UI and modest corners belong to this established desktop world.\n\nThe Manager selects, inspects and explicitly applies scenes while the independent Core owns rendering. The interface makes connection and renderer state visible and keeps the primary action within reach as content scrolls. This documented implementation replaces the former sidebar/Fusion direction.",
    "keyCharacteristics": [
      "Compact, image-led desktop browsing.",
      "Flat graphite layers and restrained blue state cues.",
      "Persistent application controls and explicit Apply.",
      "Russian and English interface copy with native keyboard semantics."
    ],
    "rules": [
      {
        "name": "The State Truth Rule",
        "body": "Connection, test transport and renderer readiness determine status copy; a green indicator alone never proves wallpaper rendering.",
        "section": "colors"
      },
      {
        "name": "The Explicit Apply Rule",
        "body": "Selecting or double-clicking a thumbnail never applies a scene. Only the pinned Apply action changes the wallpaper.",
        "section": "components"
      }
    ],
    "dos": [
      "Do keep the native Windows utility character and the approved classic Wallpaper Engine resemblance.",
      "Do use original static scene previews and identify fixture transport as having no GPU.",
      "Do preserve the pinned Apply action, scrollable inspector and resizable split.",
      "Do distinguish selection from keyboard focus and expose accessible control names.",
      "Do localize application-owned dialogs and actions with the current RU/EN setting."
    ],
    "donts": [
      "Don't restore the superseded navigation rail, rounded preview tiles or Fusion visual direction.",
      "Don't add decorative display typography, oversized cards, floating shadows or promotional page treatments.",
      "Don't apply a scene from thumbnail selection or double-click.",
      "Don't imply Windows acceptance, GPU activity or working desktop attachment from Linux offscreen captures."
    ]
  }
}
