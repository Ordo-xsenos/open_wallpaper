#include <winver.h>
#include "aetherwall_version.h"
101 ICON "aetherwall.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION AETHERWALL_VERSION_NUMERIC
 PRODUCTVERSION AETHERWALL_VERSION_NUMERIC
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "AetherWall Windows wallpaper preview\0"
      VALUE "FileVersion", AETHERWALL_VERSION "\0"
      VALUE "ProductName", "AetherWall\0"
      VALUE "ProductVersion", AETHERWALL_VERSION "\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
