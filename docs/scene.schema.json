{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AetherWall scene version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "author", "license", "preview", "canvas", "layers"],
  "properties": {
    "schemaVersion": {"type": "integer", "const": 1},
    "id": {"type": "string", "format": "uuid"},
    "title": {"$ref": "#/$defs/text"},
    "author": {"$ref": "#/$defs/text"},
    "license": {"type": "string", "minLength": 1, "maxLength": 64},
    "preview": {"$ref": "#/$defs/path"},
    "tags": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 32}},
    "fpsHint": {"type": "integer", "enum": [15, 30, 60]},
    "canvas": {
      "type": "object", "additionalProperties": false, "required": ["width", "height", "fit"],
      "properties": {
        "width": {"type": "integer", "minimum": 1, "maximum": 8192},
        "height": {"type": "integer", "minimum": 1, "maximum": 8192},
        "fit": {"enum": ["cover", "contain", "stretch"]},
        "background": {"$ref": "#/$defs/color"}
      }
    },
    "layers": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/layer"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1, "maxLength": 128},
    "path": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^assets/[A-Za-z0-9_./-]+\\.([pP][nN][gG]|[jJ][pP][eE]?[gG]|[wW][eE][bB][pP])$"},
    "color": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0, "maximum": 1}},
    "position": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -32768, "maximum": 32768}},
    "layer": {
      "type": "object", "additionalProperties": false, "required": ["id", "type"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 64},
        "type": {"enum": ["gradient", "image", "particles"]},
        "source": {"$ref": "#/$defs/path"},
        "zIndex": {"type": "integer", "minimum": -10000, "maximum": 10000},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "tint": {"$ref": "#/$defs/color"},
        "colorA": {"$ref": "#/$defs/color"},
        "colorB": {"$ref": "#/$defs/color"},
        "speed": {"type": "number", "minimum": 0, "maximum": 10},
        "effect": {"enum": ["none", "pulse"]},
        "preset": {"enum": ["stars", "rain", "snow"]},
        "parameters": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "count": {"type": "integer", "minimum": 1, "maximum": 2048},
            "speed": {"type": "number", "minimum": 0, "maximum": 10},
            "size": {"type": "number", "minimum": 1, "maximum": 64}
          }
        },
        "transform": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "position": {"$ref": "#/$defs/position"},
            "scale": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": 0.01, "maximum": 16}},
            "rotation": {"type": "number", "minimum": -3600, "maximum": 3600}
          }
        },
        "motion": {
          "type": "object", "additionalProperties": false, "required": ["amplitude", "speed"],
          "properties": {
            "amplitude": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number", "minimum": -8192, "maximum": 8192}},
            "speed": {"type": "number", "minimum": 0, "maximum": 10}
          }
        }
      },
      "allOf": [
        {"if": {"properties": {"type": {"const": "image"}}}, "then": {"required": ["source"]}, "else": {"not": {"required": ["source"]}}},
        {"if": {"properties": {"type": {"const": "particles"}}}, "then": {"required": ["preset"]}, "else": {"not": {"anyOf": [{"required": ["preset"]}, {"required": ["parameters"]}]}}},
        {"if": {"properties": {"type": {"const": "gradient"}}}, "else": {"not": {"anyOf": [{"required": ["speed"]}, {"required": ["colorA"]}, {"required": ["colorB"]}]}}}
      ]
    }
  }
}
