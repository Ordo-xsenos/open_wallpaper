# Example only. Keep your real .env out of source archives.
AETHERWALL_DEVELOPMENT=0
AETHERWALL_DATABASE_URL=postgresql://aetherwall:CHANGE_ME@postgres:5432/aetherwall
POSTGRES_PASSWORD=CHANGE_ME
AETHERWALL_PUBLIC_BASE_URL=https://catalog.example.com
AETHERWALL_ASSET_BASE_URL=
AETHERWALL_STORAGE_BACKEND=local
AETHERWALL_STORAGE_ROOT=/data/objects
AETHERWALL_RATE_LIMIT=240
# Optional: install production dependencies and use AWS roles/environment secrets.
# AETHERWALL_STORAGE_BACKEND=s3
# AETHERWALL_S3_BUCKET=your-private-bucket
# AETHERWALL_S3_ENDPOINT=https://s3.your-provider.example
